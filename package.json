{
  "name": "synthcore",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run typecheck -w server && npm run build -w client",
    "lint": "npm run lint -w client",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w server",
    "test": "npm run test -w server"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "drizzle-orm": "^0.44.5"
  }
}
